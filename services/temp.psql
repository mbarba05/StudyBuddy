create or replace function get_profile_from_search(p_search_term text)
returns table (
  user_id uuid,
  major text,
  pp_url text,
  display_name text,
  year text
)
language sql stable
as $$
select p.user_id, m.name as major, p.pp_url, p.display_name, p.year
from profiles p
join majors m
on m.id = p.major_id
where p.display_name ilike '%' || p_search_term || '%'
$$